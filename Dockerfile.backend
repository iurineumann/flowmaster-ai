# backend/Dockerfile (ou Dockerfile.backend)

FROM python:3.12-slim

# Otimização: Copiar binário do uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    ANONYMIZED_TELEMETRY=False \
    CHROMA_SERVER_NOINTERACTIVE=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    g++ \
    curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Dependências
COPY backend/requirements.txt /app/requirements.txt
RUN uv venv /app/.venv && \
    uv pip install --no-cache -r /app/requirements.txt

# ✅ CORREÇÃO CRÍTICA: Copiar arquivos de migração para a RAIZ (/app)
# O comando 'alembic' espera encontrar alembic.ini no diretório atual.
COPY alembic.ini /app/alembic.ini
COPY alembic /app/alembic

# Copiar código fonte do backend
COPY backend /app/backend

# Script de execução
COPY run_production.sh /app/run_production.sh
RUN chmod +x /app/run_production.sh

EXPOSE 8000

CMD ["/app/run_production.sh"]