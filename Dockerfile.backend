# Dockerfile para FlowMaster AI Backend

# Usa a imagem base oficial do Python (slim é menor)
FROM python:3.12-slim

# Define o diretório de trabalho dentro do container
WORKDIR /app

# Copia os arquivos de requisitos e de execução
COPY backend/requirements.txt /app/backend/requirements.txt
COPY run_production.sh /app/run_production.sh

# Copia o código-fonte restante
COPY backend /app/backend

# Define as variáveis de ambiente padrão (pode ser sobrescrito pelo Docker Compose ou Cloud)
ENV PYTHONUNBUFFERED 1
ENV VIRTUAL_ENV /app/.venv

# ----------------------------------------------------
# FASE DE INSTALAÇÃO (Substitui os passos de venv do run_production.sh)
# ----------------------------------------------------

#Update PIP
RUN python -m pip install --upgrade pip

# Cria o ambiente virtual
RUN python -m venv .venv

# Ativa o ambiente e instala as dependências
RUN . .venv/bin/activate && \
    pip install --no-cache-dir -r backend/requirements.txt && \
    # Limpa o cache após a instalação
    pip uninstall -y pip && \
    pip install pip

# Torna o script de produção executável
RUN chmod +x run_production.sh

# Expõe a porta que o Gunicorn vai rodar
EXPOSE 8000

# ----------------------------------------------------
# COMANDO DE INICIALIZAÇÃO
# ----------------------------------------------------

# Comando de execução. 
# Usamos o comando Gunicorn diretamente, sem o script run_production.sh
# O script run_production.sh foi útil na VM, mas aqui usamos a sintaxe pura do Docker
CMD ["/app/.venv/bin/python", "-m", "gunicorn", "backend.main:app", \
    "--workers", "5", "--worker-class", "uvicorn.workers.UvicornWorker", \
    "--bind", "0.0.0.0:8000"]